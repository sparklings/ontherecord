# 의존성
node_modules/

# 빌드 산출물
main.js
dist/
*.tsbuildinfo

# 비밀 값
.env
.env.local
.env.*.local
!.env.example

# 로그·임시 파일
*.log
*.tmp

# 전사 엔진 런타임·모델 (사용자별 데이터 폴더에 설치하며 저장소에 넣지 않음)
*.gguf
ggml-*.bin
runtimes/
models/

# 개발 PC 로컬 전용 폴더
.local/

# 표본 데이터 전체: 오디오·전사문·메타데이터 모두 Git 외부 반출 금지.
# 폴더 구조만 .gitkeep으로 제공한다.
/samples/**
!/samples/**/
!/samples/**/.gitkeep

# 어느 위치에 있어도 오디오·전사 산출물은 반출하지 않는다
*.m4a
*.mp3
*.wav
*.aac
*.ogg
*.flac
*.opus
*.wma
*.srt
*.vtt
# 측정 기록에서 생성하는 요약(scripts\summarize-records.ps1). 원본은 benchmarks\records\
/benchmarks/summary/

# OS·편집기
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
